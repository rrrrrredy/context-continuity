{
  "description": "Local-first task continuity across compaction, resume, clear, and subagent handoff.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "timeout": 10,
            "statusMessage": "Saving minimum task continuity state"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "^other$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/hooks/run.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
