{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-continuity.local/spec/execution-guard-view.schema.json",
  "title": "Read-only execution guard continuity view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_ref",
    "contract_version",
    "phase",
    "open_commitments",
    "evidence_refs",
    "captured_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_ref": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "integer", "minimum": 1 },
    "phase": { "type": "string" },
    "open_commitments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "captured_at": { "type": "string", "format": "date-time" }
  }
}
