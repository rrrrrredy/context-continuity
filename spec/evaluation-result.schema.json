{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-continuity.local/spec/evaluation-result.schema.json",
  "title": "Three-arm continuity evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_kind",
    "started_at",
    "environment",
    "case_results",
    "aggregate",
    "protocol_assertions",
    "claim_limit"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_kind": { "enum": ["protocol_fixture", "real_agent"] },
    "started_at": { "type": "string", "format": "date-time" },
    "environment": { "type": "object" },
    "case_results": { "type": "array", "minItems": 1 },
    "aggregate": { "type": "object" },
    "protocol_assertions": { "type": "object" },
    "claim_limit": { "type": "string", "minLength": 1 }
  }
}
